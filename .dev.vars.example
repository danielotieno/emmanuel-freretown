# Copy to .dev.vars for `pnpm preview` (the Worker running locally in workerd).
# Never commit .dev.vars. Staging and production secrets are set in Cloudflare with
# `pnpm exec wrangler secret put <NAME> --env staging|production` (docs/operations/environments.md).
#
# The database connection is not here: it comes from the HYPERDRIVE binding, overridden locally by
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .env.
#
# Secrets the app will read, each added by the issue that first uses it. Local values are
# throwaway test values only.

# Better Auth (#17): signs staff session cookies and encrypts authenticator secrets. Any random
# string of 32+ characters locally; the staff portal (http://admin.localhost:3000) won't start
# without it.
BETTER_AUTH_SECRET=

# Cloudflare Access (#17). Staging and production verify Access's JWT on every staff request;
# locally the check is skipped unless both are set. CF_ACCESS_TEAM_DOMAIN is a var in
# wrangler.jsonc; CF_ACCESS_AUD is the Access application's AUD tag.
# CF_ACCESS_TEAM_DOMAIN=ack-emmanuel.cloudflareaccess.com
# CF_ACCESS_AUD=

# Mobile Sasa SMS (#14, D43). An mbs_ token with the "send messages" scope (a trial account
# sends only to its own registered number). The webhook secret is in the portal under
# Settings -> Webhooks. The callback URL is this environment's
# https://<host>/api/webhooks/sms-delivery; leave it empty to use the account's callback URL.
MOBILESASA_API_TOKEN=
MOBILESASA_SENDER_ID=MOBILESASA
MOBILESASA_WEBHOOK_SECRET=
MOBILESASA_CALLBACK_URL=

# Cloudflare Turnstile (#13). Cloudflare publishes test keys that always pass.
TURNSTILE_SECRET_KEY=
# The public site key is a var (wrangler.jsonc) in staging and production; locally the app uses
# Cloudflare's always-pass test key when it is unset.
# TURNSTILE_SITE_KEY=

# Automated tests only (Playwright): no SMS, every code 000000. Never in staging or production,
# and never beside MOBILESASA_API_TOKEN (test mode refuses to run then). See the README.
# E2E_TEST_MODE=1

# Rate-limit keys (#13): HMAC-SHA256 of phone numbers and IPs. 32+ random characters, different
# in each environment. Changing it only resets the current limits.
RATE_LIMIT_SECRET=

# OTP codes and verification tokens (#15): their HMAC key. 32+ random characters, different in
# each environment.
OTP_SECRET=

# Sentry (#9). Leave empty locally to send nothing.
SENTRY_DSN=
