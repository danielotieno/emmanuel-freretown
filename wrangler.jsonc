{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = local development and `pnpm preview`. Deploys always name an environment
  // (`--env staging` or `--env production`): the Deploy workflow, or `pnpm deploy:<env>` by hand
  // (ADR 0002 amendment).
  "name": "ack-emmanuel-freretown",
  // Wraps .open-next/worker.js (generated by the OpenNext build) with Sentry.
  "main": "worker.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Reachable only through the church's own domains; no *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs (docs/operations/observability.md): every request logged (low traffic), query
  // strings removed, no automatic traces (they record subrequest URLs we haven't reviewed).
  // Retention is fixed by the plan: 7 days on Workers Paid. Environments inherit this block.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": false },
  },
  "vars": { "SENTRY_ENVIRONMENT": "local" },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      // The app's login (member of app_runtime), never the owner. Set the real string, with
      // the password from `pnpm db:app-login`, in CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
      // (see .env.example).
      // Wrangler requires a password here, so this one is a placeholder that never connects.
      "localConnectionString": "postgres://ack_app:set-in-dotenv@localhost:5432/ack_dev",
    },
  ],
  "env": {
    "staging": {
      "routes": [
        { "pattern": "staging.ackemmanuelfreretown.org", "custom_domain": true },
        { "pattern": "admin-staging.ackemmanuelfreretown.org", "custom_domain": true },
      ],
      "placement": { "mode": "smart" },
      // observability is inherited from the top level; vars are not. SENTRY_DSN is a secret.
      "vars": { "SENTRY_ENVIRONMENT": "staging" },
      // Neon project ack-nonprod, branch staging. Created with caching disabled.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "e2d8d2f3543e4e968faaf9bb5e2955a3",
          // Never connected to. OpenNext's deploy starts wrangler's local proxy for this
          // environment, which refuses a Hyperdrive binding without a local string (#49).
          "localConnectionString": "postgres://unused:unused@localhost:5432/unused",
        },
      ],
    },
    "production": {
      "routes": [
        { "pattern": "ackemmanuelfreretown.org", "custom_domain": true },
        { "pattern": "admin.ackemmanuelfreretown.org", "custom_domain": true },
      ],
      // Run near the database in Frankfurt rather than near the visitor (ADR 0002).
      "placement": { "mode": "smart" },
      // observability is inherited from the top level; vars are not. SENTRY_DSN is a secret.
      "vars": { "SENTRY_ENVIRONMENT": "production" },
      // Neon project ack-production. Created with caching disabled.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "ff0f73900bc64771991e69f036276465",
          // Never connected to. OpenNext's deploy starts wrangler's local proxy for this
          // environment, which refuses a Hyperdrive binding without a local string (#49).
          "localConnectionString": "postgres://unused:unused@localhost:5432/unused",
        },
      ],
    },
  },
}
