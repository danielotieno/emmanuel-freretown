{
  "name": "ack-emmanuel-freretown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "pnpm gen",
    "gen": "pnpm gen:i18n && pnpm gen:cf",
    "gen:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie baseLocale --no-emit-readme --silent",
    "gen:cf": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "i18n:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie baseLocale --no-emit-readme --watch",
    "dev": "pnpm gen:i18n && next dev",
    "build": "pnpm gen:i18n && next build",
    "start": "next start",
    "preview": "pnpm gen:i18n && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:deps && pnpm format:check && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:app-login": "node scripts/db-app-login.ts",
    "auth:schema": "./scripts/generate-auth-schema.sh",
    "deploy:staging": "pnpm gen:i18n && opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging",
    "deploy:production": "pnpm gen:i18n && opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "smoke:worker": "./scripts/worker-smoke.sh"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.27",
    "@opennextjs/cloudflare": "1.20.18",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.27",
    "dependency-cruiser": "18.9.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1",
    "wrangler": "4.167.0"
  }
}
