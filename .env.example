# Copy to .env for local work. Never commit .env.

# Migrations (`pnpm db:migrate`) run as the database owner role.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ack_dev

# Integration tests wipe and re-migrate this database. Its name must contain "test".
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ack_test

# The app reaches Postgres through the HYPERDRIVE binding. For `pnpm dev` and `pnpm preview`
# this overrides localConnectionString in wrangler.jsonc.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://postgres:postgres@localhost:5432/ack_dev
